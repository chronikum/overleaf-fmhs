# Copy this file to .env and edit the values for your server.

# Where your reverse proxy exposes Overleaf publicly.
OVERLEAF_SITE_URL=https://your-overleaf.example.com

# By default Overleaf only binds to localhost so a reverse proxy can publish it.
OVERLEAF_LISTEN_IP=127.0.0.1
OVERLEAF_PORT=8080

OVERLEAF_APP_NAME=Overleaf Extended CE
OVERLEAF_NAV_TITLE=Overleaf Extended CE
OVERLEAF_ADMIN_EMAIL=admin@example.com
OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com

# Generate with: openssl rand -hex 32
OVERLEAF_SESSION_SECRET=change-me-generate-a-long-random-string

# For a reverse proxy on the host, loopback is usually enough.
# If your proxy is in Docker, add its Docker network CIDR, for example:
# OVERLEAF_TRUSTED_PROXY_IPS=loopback,172.18.0.0/16
OVERLEAF_BEHIND_PROXY=true
OVERLEAF_TRUSTED_PROXY_IPS=loopback

# Keep the instance private unless you intentionally publish projects publicly.
OVERLEAF_ALLOW_PUBLIC_ACCESS=false

# Useful for local-account installs without SMTP configured.
EMAIL_CONFIRMATION_DISABLED=true
